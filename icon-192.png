/* ═══════════════════════════════════════════════════════════════
   SHIFT SCHEDULE — styles.css
   ═══════════════════════════════════════════════════════════════ */

/* ── Variables ─────────────────────────────────────────────── */
:root {
  --bg:#0d0d14; --bg2:#11111c; --surface:#161622;
  --glass:rgba(255,255,255,0.05); --glass-border:rgba(255,255,255,0.1);
  --text:#e8e8f4; --muted:#7878a0; --subtle:#1f1f30;
  --primary:#5b7fff; --primary2:#38d9c0;
  --lucifer:#5b7fff; --eren:#38d9c0; --neon:#e85535;
  --leave-sick:#e85555; --leave-holiday:#f0c030; --leave-personal:#9b85f5;
}
[data-theme="light"] {
  --bg:#f4f4fb; --bg2:#fff; --surface:#fff;
  --glass:rgba(0,0,0,0.03); --glass-border:rgba(0,0,0,0.12);
  --text:#0a0a1a; --muted:#555570; --subtle:#e0e0ee;
  --primary:#3a5bd9; --primary2:#0a7a60;
}

/* ── Reset ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { height: 100%; }
body {
  background: var(--bg); color: var(--text);
  font-family: 'Space Grotesk', sans-serif;
  min-height: 100%; overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
a { color: var(--primary); text-decoration: none; }
input, select, textarea, button { font-family: inherit; }
label { font-size: 0.75rem; font-weight: 600; color: var(--muted); display: block; margin-bottom: 5px; }

/* ── Splash ─────────────────────────────────────────────────── */
#splash {
  position: fixed; inset: 0; z-index: 9999;
  background: #0a0a0f;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
  animation: splashFade 0.6s ease 3.8s forwards;
  overflow: hidden;
}
@keyframes splashFade { to { opacity: 0; pointer-events: none; visibility: hidden; } }
.splash-ring {
  position: absolute; border-radius: 50%;
  animation: ringPulse 2s ease-in-out infinite;
}
.splash-ring-1 { width: 260px; height: 260px; border: 1px solid rgba(91,127,255,0.18); }
.splash-ring-2 { width: 380px; height: 380px; border: 1px solid rgba(56,217,192,0.1);  animation-delay: 0.5s; }
.splash-ring-3 { width: 500px; height: 500px; border: 1px solid rgba(91,127,255,0.06); animation-delay: 1s; }
@keyframes ringPulse { 0%,100%{transform:scale(1);opacity:0.4;} 50%{transform:scale(1.04);opacity:1;} }
.splash-logo {
  width: 88px; height: 88px;
  animation: splashPop 0.7s cubic-bezier(0.34,1.56,0.64,1) 0.2s both;
  filter: drop-shadow(0 0 20px rgba(91,127,255,0.5));
}
@keyframes splashPop { from{transform:scale(0.2) rotate(-10deg);opacity:0;} to{transform:scale(1) rotate(0);opacity:1;} }
.splash-title {
  font-size: 1.5rem; font-weight: 700; letter-spacing: 0.05em;
  background: linear-gradient(135deg, #f0f0ff 30%, #a0a0cc);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  animation: splashSlide 0.5s ease 0.7s both;
}
.splash-title em {
  font-style: normal;
  background: linear-gradient(135deg, #5b7fff, #38d9c0);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.splash-tagline {
  font-size: 0.72rem; font-weight: 500; letter-spacing: 0.18em;
  text-transform: uppercase; color: #6b6b90;
  animation: splashSlide 0.4s ease 1.1s both;
}
.splash-bar-wrap {
  width: 240px; height: 4px; background: rgba(255,255,255,0.1);
  border-radius: 4px; overflow: hidden;
  animation: splashSlide 0.4s ease 0.9s both; margin-top: 4px;
}
.splash-bar {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, #5b7fff, #38d9c0, #5b7fff);
  background-size: 200% 100%;
  animation: splashBarLoad 3s ease 0.9s forwards, shimmer 1.5s linear 0.9s infinite;
  width: 0;
}
@keyframes splashBarLoad { to { width: 100%; } }
@keyframes shimmer { 0%{background-position:200% 0;} 100%{background-position:-200% 0;} }
@keyframes splashSlide { from{transform:translateY(18px);opacity:0;} to{transform:translateY(0);opacity:1;} }

/* ── Login ──────────────────────────────────────────────────── */
#loginScreen {
  position: fixed; inset: 0; z-index: 1000;
  background: var(--bg);
  display: none; align-items: center; justify-content: center; padding: 20px;
  overflow-y: auto;
}
.login-card {
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: 20px; padding: 32px 28px; width: 100%; max-width: 380px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
[data-theme="light"] .login-card { box-shadow: 0 8px 30px rgba(0,0,0,0.1); }
.login-logo { width: 56px; height: 56px; margin: 0 auto 12px; display: block; }
.login-app-name { text-align: center; font-size: 1.3rem; font-weight: 800; margin-bottom: 4px; }
.login-tagline-text { text-align: center; font-size: 0.75rem; color: var(--muted); margin-bottom: 20px; }
.login-field { margin-bottom: 14px; }
.login-field input, .login-field select {
  width: 100%; padding: 11px 14px;
  background: var(--bg2); border: 1px solid var(--glass-border); border-radius: 10px;
  color: var(--text); font-size: 0.88rem; outline: none;
  transition: border-color 0.2s;
}
.login-field input:focus, .login-field select:focus { border-color: var(--primary); }
.label-hint { font-weight: 400; font-size: 0.65rem; opacity: 0.7; }
.login-error { font-size: 0.72rem; color: #ff6c6c; min-height: 18px; margin-bottom: 6px; }
.login-btn {
  width: 100%; padding: 12px;
  background: linear-gradient(135deg, var(--primary), var(--primary2));
  border: none; border-radius: 10px;
  color: #fff; font-size: 0.9rem; font-weight: 700;
  cursor: pointer; transition: opacity 0.2s; margin-bottom: 4px;
}
.login-btn:hover { opacity: 0.9; }
.login-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.login-btn-secondary {
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text); font-weight: 600;
}
.login-links { display: flex; justify-content: center; gap: 8px; font-size: 0.68rem; color: var(--muted); margin: 10px 0; }
.login-links .dot { color: var(--muted); }
.login-divider { display: flex; align-items: center; gap: 10px; margin: 12px 0; }
.login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1px; background: var(--glass-border); }
.login-divider span { font-size: 0.62rem; color: var(--muted); }
.login-info-link { text-align: center; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--glass-border); }
.login-info-link button { background: none; border: none; cursor: pointer; font-size: 0.78rem; font-weight: 600; color: var(--primary); }

/* ── App layout ─────────────────────────────────────────────── */
#app { padding: clamp(12px,3vw,28px) clamp(10px,3vw,24px); padding-bottom: 40px; }

/* ── Topbar ─────────────────────────────────────────────────── */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 10px; margin-bottom: 14px; padding: 11px 16px;
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 14px; backdrop-filter: blur(16px);
  position: relative; z-index: 400;
}
[data-theme="light"] .topbar { background: #fff; border-color: rgba(0,0,0,0.1); box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.topbar-left { display: flex; align-items: center; gap: 10px; cursor: pointer; }
.topbar-avatar {
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 0.8rem; flex-shrink: 0;
}
.topbar-name { font-size: 0.9rem; font-weight: 700; }
.topbar-role { font-size: 0.62rem; color: var(--muted); }
.topbar-right { display: flex; align-items: center; gap: 6px; }
.icon-btn {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 1rem;
  position: relative; transition: all 0.2s;
}
.notif-badge {
  position: absolute; top: -4px; right: -4px;
  background: #ff6c6c; color: #fff; font-size: 0.5rem;
  min-width: 14px; height: 14px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center; padding: 0 3px;
}
.user-dropdown {
  position: absolute; top: calc(100% + 8px); left: 0;
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: 12px; padding: 6px; min-width: 160px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3); z-index: 500; display: none;
}
.user-dropdown.open { display: block; }
.dropdown-item {
  padding: 8px 12px; border-radius: 8px; font-size: 0.82rem;
  cursor: pointer; transition: background 0.15s;
}
.dropdown-item:hover { background: var(--glass); }

/* ── Page Tabs ──────────────────────────────────────────────── */
.pg-tabs {
  display: flex; gap: 3px;
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 14px; padding: 5px; margin-bottom: 16px;
  overflow-x: auto; scrollbar-width: none;
}
.pg-tabs::-webkit-scrollbar { display: none; }
.pg-tab {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
  padding: 9px 8px; border-radius: 10px; border: none;
  background: transparent; color: var(--muted);
  font-size: 0.65rem; font-weight: 600; cursor: pointer;
  transition: all 0.18s; position: relative; white-space: nowrap;
}
.pg-tab-icon { font-size: 1.1rem; line-height: 1; }
.pg-tab.active { background: linear-gradient(135deg, var(--primary), var(--primary2)); color: #fff; font-weight: 800; }
.pg-tab-badge {
  position: absolute; top: 4px; right: 4px;
  background: #ff6c6c; color: #fff; font-size: 0.48rem; font-weight: 700;
  min-width: 13px; height: 13px; border-radius: 7px; padding: 0 3px;
  display: none; align-items: center; justify-content: center;
}
.pg-page { display: none; }
.pg-page.active { display: block; }
[data-theme="light"] .pg-tabs { background: #f0f2f7; border-color: rgba(0,0,0,0.08); }
[data-theme="light"] .pg-tab { color: #888; }
[data-theme="light"] .pg-tab.active { color: #fff; }

/* ── Panels ─────────────────────────────────────────────────── */
.panel {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 14px; padding: 18px; backdrop-filter: blur(16px);
}
[data-theme="light"] .panel { background: #fff; border-color: rgba(0,0,0,0.1); box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.mt-14 { margin-top: 14px; }
.panel-title {
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 14px;
  display: flex; align-items: center; gap: 8px;
}

/* ── Buttons ─────────────────────────────────────────────────── */
.btn {
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text); border-radius: 8px; padding: 7px 14px;
  font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all 0.2s;
  display: inline-flex; align-items: center; gap: 5px;
}
.btn.primary { background: linear-gradient(135deg, var(--primary), var(--primary2)); border: none; color: #fff; }
.btn.danger  { background: rgba(255,108,108,0.1); border-color: rgba(255,108,108,0.3); color: #ff6c6c; }
.btn.success { background: rgba(77,255,210,0.1); border-color: rgba(77,255,210,0.3); color: #38d9c0; }
.btn.sm { font-size: 0.65rem; padding: 5px 10px; border-radius: 6px; }
.active-filter { background: linear-gradient(135deg, var(--primary), var(--primary2)) !important; border: none !important; color: #fff !important; }

/* ── Schedule Table ─────────────────────────────────────────── */
.week-nav {
  display: flex; align-items: center; gap: 10px;
  justify-content: center; margin-bottom: 10px;
}
.week-btn {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 8px; padding: 6px 12px; cursor: pointer;
  color: var(--text); font-size: 1rem; transition: all 0.15s;
}
.week-label { font-size: 0.82rem; font-weight: 600; color: var(--text); }
.today-btn { font-size: 0.72rem; }
.schedule-wrapper {
  overflow-x: auto; border-radius: 14px;
  border: 1px solid var(--glass-border);
  background: var(--glass); -webkit-overflow-scrolling: touch;
  margin-bottom: 12px;
}
[data-theme="light"] .schedule-wrapper { background: #fff; }
table { width: 100%; border-collapse: collapse; font-size: 0.72rem; }
th, td { padding: 8px 6px; text-align: center; border-bottom: 1px solid var(--subtle); }
th { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; color: var(--muted); }
.today-col { background: rgba(91,127,255,0.06); }
.date-num { font-size: 0.9rem; font-weight: 700; }
.emp-col { text-align: left; min-width: 90px; padding-left: 10px; }
.emp-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
.emp-name { font-weight: 600; font-size: 0.72rem; }
.shift-block {
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 6px 4px; border-radius: 8px; cursor: pointer;
}
.shift-label { font-size: 0.6rem; font-weight: 700; }
.shift-time  { font-size: 0.52rem; opacity: 0.8; font-family: 'JetBrains Mono', monospace; }
.shift-off   { color: var(--muted); font-size: 0.72rem; }
.drag-hint   { text-align: center; font-size: 0.62rem; color: var(--muted); margin-bottom: 8px; opacity: 0.6; }

/* ── Summary ─────────────────────────────────────────────────── */
.summary-section { margin-top: 14px; }
.summary-heading { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
.summary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap: 10px; }
.summary-card { background: var(--glass); border: 1px solid var(--glass-border); border-radius: 10px; padding: 12px; font-size: 0.72rem; }
.summary-count { display: block; font-size: 0.62rem; color: var(--muted); margin-top: 3px; }

/* ── Requests ────────────────────────────────────────────────── */
.req-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 0; border-bottom: 1px solid var(--subtle); gap: 8px;
}
.req-info { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
.req-name   { font-weight: 700; font-size: 0.82rem; }
.req-detail { font-size: 0.68rem; color: var(--muted); }
.req-actions { display: flex; gap: 6px; flex-shrink: 0; }
.status-badge {
  font-size: 0.58rem; padding: 3px 8px; border-radius: 6px;
  font-weight: 700; text-transform: uppercase; flex-shrink: 0;
}
.status-badge.pending  { background: rgba(255,184,77,0.15); color: #f0a030; }
.status-badge.approved { background: rgba(56,217,192,0.15); color: #38d9c0; }
.status-badge.rejected { background: rgba(255,108,108,0.15); color: #ff6c6c; }
.badge-pill {
  background: #ff6c6c; color: #fff; font-size: 0.5rem;
  padding: 2px 7px; border-radius: 10px; font-weight: 700; margin-left: 4px;
}
.role-tag {
  font-size: 0.55rem; padding: 1px 6px; border-radius: 5px;
  font-weight: 700; margin-left: 6px;
}
.role-tag.manager { background: rgba(255,184,77,0.15); color: #ffb84d; }
.role-tag.staff   { background: rgba(91,127,255,0.12); color: var(--primary); }

/* ── Members ─────────────────────────────────────────────────── */
.member-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 0; border-bottom: 1px solid var(--subtle);
}
.member-info { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
.member-avatar {
  width: 32px; height: 32px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 0.72rem; flex-shrink: 0;
}
.member-name { font-weight: 700; font-size: 0.85rem; }
.member-meta { font-size: 0.65rem; color: var(--muted); }
.biz-code-badge {
  margin-left: auto; font-size: 0.6rem;
  background: rgba(91,127,255,0.12); color: var(--primary);
  border: 1px solid rgba(91,127,255,0.2); padding: 2px 8px;
  border-radius: 8px; font-family: 'JetBrains Mono', monospace;
  font-weight: 700; cursor: pointer; letter-spacing: 0.05em;
}

/* ── Attendance / Work hours ────────────────────────────────── */
.att-row {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--subtle);
  font-size: 0.75rem;
}
.att-date  { color: var(--muted); flex-shrink: 0; }
.att-times { font-family: 'JetBrains Mono', monospace; color: var(--text); }
.hours-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; font-size: 0.75rem; }
.hours-name { width: 80px; flex-shrink: 0; font-weight: 600; }
.hours-bar-wrap { flex: 1; height: 6px; background: var(--subtle); border-radius: 3px; overflow: hidden; }
.hours-bar  { height: 100%; border-radius: 3px; transition: width 0.5s; }
.hours-val  { width: 60px; text-align: right; color: var(--muted); font-family: monospace; flex-shrink: 0; }

/* ── Presence ────────────────────────────────────────────────── */
.presence-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap: 10px; margin-top: 8px; }

/* ── Clock-in card ──────────────────────────────────────────── */
.clock-in-card {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 14px; padding: 14px 16px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-bottom: 12px;
}
.clock-status { font-size: 0.8rem; font-weight: 600; }

/* ── Admin panel ─────────────────────────────────────────────── */
.admin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.admin-card { background: rgba(255,107,107,0.06); border: 1px solid rgba(255,107,107,0.18); border-radius: 10px; padding: 14px; }
.admin-card-title { font-size: 0.72rem; font-weight: 700; margin-bottom: 4px; }
.admin-card-title.danger { color: #ff6c6c; }
.admin-card-desc { font-size: 0.62rem; color: var(--muted); margin-bottom: 10px; }
.admin-badge { font-size: 0.5rem; background: rgba(255,77,0,0.15); color: var(--neon); border: 1px solid rgba(255,77,0,0.3); padding: 2px 7px; border-radius: 10px; letter-spacing: 0.1em; margin-left: 6px; }

/* ── Thunder dashboard ──────────────────────────────────────── */
.thunder-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.thunder-title  { font-size: 1.3rem; font-weight: 800; }
.thunder-sub    { font-size: 0.72rem; color: var(--muted); }
.biz-card {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: 14px; padding: 16px; margin-bottom: 12px;
}
.biz-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.biz-name { font-size: 1rem; font-weight: 800; }
.biz-code { font-size: 0.72rem; color: var(--muted); }
.biz-code strong { font-family: monospace; background: var(--subtle); padding: 2px 8px; border-radius: 6px; color: var(--primary); }
.biz-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; font-size: 0.72rem; }
.biz-stat { background: var(--subtle); border-radius: 8px; padding: 8px; text-align: center; }
.biz-stat div:first-child { font-size: 1.1rem; font-weight: 800; }
.biz-stat div:last-child  { color: var(--muted); }

/* ── Alerts / notifications ─────────────────────────────────── */
.alert-entry {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 10px;
  padding: 8px 0; border-bottom: 1px solid var(--subtle);
}
.alert-entry.unread { background: rgba(91,127,255,0.05); border-radius: 6px; padding: 8px 6px; }
.alert-msg  { font-size: 0.8rem; flex: 1; }
.alert-time { font-size: 0.62rem; color: var(--muted); flex-shrink: 0; }
.notif-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 700; display: none; }
.notif-backdrop.open { display: block; }
.notif-drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(320px, 90vw);
  background: var(--surface); border-left: 1px solid var(--glass-border);
  z-index: 800; transform: translateX(100%); transition: transform 0.3s;
  display: flex; flex-direction: column; overflow: hidden;
}
.notif-drawer.open { transform: translateX(0); }
.notif-drawer-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px; border-bottom: 1px solid var(--glass-border); font-weight: 700;
}
#notifList { flex: 1; overflow-y: auto; padding: 12px; }
.notif-item { padding: 10px 0; border-bottom: 1px solid var(--subtle); }
.notif-msg  { font-size: 0.8rem; }
.notif-time { font-size: 0.62rem; color: var(--muted); margin-top: 3px; }

/* ── Modals ──────────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6);
  z-index: 1000; display: none; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.open { display: flex; }
.info-modal { align-items: flex-start; overflow-y: auto; background: rgba(0,0,0,0.85); }
.modal {
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: 16px; padding: 24px; width: 100%; max-width: 420px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.5); max-height: 90vh; overflow-y: auto;
}
.modal-title { font-size: 1.05rem; font-weight: 800; margin-bottom: 16px; }
.modal-actions { display: flex; gap: 10px; margin-top: 16px; }
.modal-actions .btn { flex: 1; justify-content: center; }
.info-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; gap: 12px; }
.info-card { background: var(--surface); border: 1px solid var(--glass-border); border-radius: 12px; padding: 16px; margin-bottom: 12px; font-size: 0.8rem; color: var(--muted); line-height: 1.7; }
.info-card-title { font-size: 0.88rem; font-weight: 800; color: var(--text); margin-bottom: 6px; }
.info-table { font-size: 0.75rem; }
.info-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--subtle); }
.info-row span:last-child { font-weight: 600; color: var(--text); }

/* ── Misc ────────────────────────────────────────────────────── */
.empty-msg { font-size: 0.72rem; color: var(--muted); font-style: italic; }
.spinner {
  width: 32px; height: 32px; border: 3px solid var(--glass-border);
  border-top-color: var(--primary); border-radius: 50%;
  animation: spin 0.8s linear infinite; margin: 0 auto;
}
@keyframes spin { to { transform: rotate(360deg); } }
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(80px);
  background: var(--surface); border: 1px solid var(--glass-border);
  color: var(--text); border-radius: 10px; padding: 10px 20px;
  font-size: 0.82rem; font-weight: 600; z-index: 9999;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  transition: transform 0.3s, opacity 0.3s; opacity: 0;
}
.toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
#alertBanner:not(:empty) {
  background: rgba(91,127,255,0.1); border: 1px solid rgba(91,127,255,0.2);
  border-radius: 10px; padding: 10px 14px; margin-bottom: 12px;
  font-size: 0.78rem; color: var(--primary);
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 480px) {
  .admin-grid { grid-template-columns: 1fr; }
  .week-nav { flex-wrap: wrap; }
}



.login-bottom-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--glass-border);
  font-size: 0.68rem;
  color: var(--muted);
}
.login-bottom-links button {
  background: none; border: none; cursor: pointer;
  font-size: 0.68rem; font-weight: 600; color: var(--primary); padding: 0;
}
.login-bottom-links a {
  color: var(--muted); font-size: 0.68rem; text-decoration: underline;
}
.login-bottom-links span { color: var(--muted); }
